# Environment Configuration for AI Red Team Blue-Green Deployment

# Environment & Server
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
API_KEY=dev-secret-key-12345

# Database (defaults to SQLite if DATABASE_URL not set)
DATABASE_URL=sqlite:///./redteam.db

# Deployment Driver: 'local' (simulated in-process / router) or 'k8s'
DEPLOYMENT_DRIVER=local

# LLM Mode: 'mock' (rule-based deterministic testing) or 'provider' (live LLM)
LLM_MODE=mock
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Thresholds & Constraints
RISK_THRESHOLD=0.25
MAX_RESPONSE_TIME_MS=4000

# Allowed Sandboxed Target Hosts
ALLOWED_TARGET_HOSTS=["localhost","127.0.0.1","agent-green","agent-blue"]

# Next.js Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_KEY=dev-secret-key-12345

